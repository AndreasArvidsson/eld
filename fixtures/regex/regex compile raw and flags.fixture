const regex: Regex = Regex.compile(r"\b[A-Z]\w+\d{2}\b");
print(regex.pattern());
print(regex.matcher("Item42").matches());
print(regex.matcher("item42").matches());
const insensitive = Regex.compile("abc", 2);
print(insensitive.flags());
print(insensitive.matcher("ABC").matches());
print(Regex.matches(r"\d+", "123"));
print(Regex.matches(r"\d+", "abc123"));

