const matcher = Regex.compile(r"(\d+)").matcher("a12b34");
print(matcher.replaceAll("<$1>"));
print(matcher.replaceFirst("#"));
print(matcher.replaceAll(Matcher.quoteReplacement("$1")));
const literal: Regex = Regex.compile(Regex.quote("a.b"));
print(literal.matcher("a.b").matches());
print(literal.matcher("axb").matches());

