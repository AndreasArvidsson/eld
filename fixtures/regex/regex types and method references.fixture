func compile(pattern: string) Regex {
    return Regex.compile(pattern);
}
func match(regex: Regex, text: string) Matcher {
    return regex.matcher(text);
}
const regex: Regex = compile(r"\d+");
const matcher: Matcher = match(regex, "42");
const matches = matcher.matches;
print(matches());
const quote = Regex.quote;
print(Regex.compile(quote("a.b")).matcher("a.b").matches());

