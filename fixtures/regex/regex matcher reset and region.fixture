const regex: Regex = Regex.compile(r"\d+");
const matcher: Matcher = regex.matcher("123abc");
print(matcher.lookingAt());
print(matcher.matches());
print(matcher.reset("456").matches());
print(matcher.pattern().pattern());
print(matcher.reset().find());
print(matcher.reset("x789y").region(1, 4).matches());
print(matcher.regionStart());
print(matcher.regionEnd());
print(matcher.usePattern(Regex.compile("abc")).reset("abc").matches());

