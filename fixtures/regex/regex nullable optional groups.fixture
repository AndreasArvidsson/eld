const matcher = Regex.compile(r"(?<optional>x)?y").matcher("y");
print(matcher.matches());
const numbered: string | null = matcher.group(1);
const named: string | null = matcher.group("optional");
print(numbered == null);
print(named == null);
print(matcher.group());

