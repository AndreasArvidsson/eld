const regex = Regex.compile(r"(?<digits>\d+)");
const matcher: Matcher = regex.matcher("abc123def456");
while (matcher.find()) {
    print(matcher.group());
    print(matcher.group(1));
    print(matcher.group("digits"));
    print(matcher.start());
    print(matcher.start("digits"));
    print(matcher.end(1));
}
print(matcher.groupCount());
print(matcher.find(6));
print(matcher.group());

