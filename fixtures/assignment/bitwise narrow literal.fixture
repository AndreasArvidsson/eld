var value: i8 = 1;
value |= 255;
print(value);
value &= 255;
print(value);
value ^= 255;
print(value);
var wideChoice: i64 = 255;
value |= true ? wideChoice : wideChoice;
print(value);
var large: i8 = 1;
large |= 3_000_000_255;
print(large);
var computed: i8 = 1;
computed |= 4_294_967_296 + 2;
print(computed);
var selected: i8 = 1;
selected |= true ? 4_294_967_296 + 2 : 0;
print(selected);

