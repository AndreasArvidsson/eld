class Foo {
    public var value: i32;
    public constructor(value: i32) {
        this.value = value;
    }
}

const mutable: [Foo] = [new Foo(1)];
mutable[0] = new Foo(2);
mutable[0].value = 3;

const fixed: const [Foo] = [new Foo(4)];
fixed[0].value = 5;
const fixedView: const [Foo] = mutable;

const fixedElements: [const Foo] = [new Foo(6)];
fixedElements[0] = new Foo(7);

const fixedBoth: const [const Foo] = [new Foo(8)];

const object: const Foo = new Foo(9);
const optional: const Foo | null = object;
const copied: [Foo] = [...fixed];

func identity(value: const Foo) const Foo {
    return value;
}

func consume(value: any) i32 {
    return 1;
}

print(mutable[0].value);
print(fixed[0].value);
print(fixedElements[0].value);
print(fixedBoth[0].value);
print(object.value);
print(identity(object).value);
print(consume(object));
print(consume(fixed));
print(consume(optional));
print(fixedView[0].value);
print(copied[0].value);
for (value : fixed) {
    print(value.value);
}

