class C {
    public var value: i32 = 0;
    public func f(x: i32) i32 { return 1; }
    public func f(x: string) i32 { this.value = 2; return this.value; }
}
const c: const C = new C();
const callback: (string) => i32 = c.f;
print(callback("x"));

