func defaultNumber() i32 { print("default evaluated"); return 10; }
class Signatures {
    public constructor(count: i32 = 1, *, label: string = "default") {}
    public func optional(value: string | null = null, *, count: i32 = 1) string | null { return value; }
    public func choose(value: i32) i32 { return value; }
    public func choose(value: string) string { return value; }
    public static func named(*, label: string = "default") string { return label; }
    public func discardedOptional(_?: i32) void {}
    public func discardedRequired(_: i32) void {}
    public func discardedDefault(_: i32 = 0) void {}
    public func expression(value: i32 = 1 + 2, *, label: string = f"value: {value}") string { return label; }
    public func computed(value: i32 = defaultNumber()) i32 { return value; }
}
class UnionConstructor {
    public constructor(_?: string | null, value: string | null = null) {}
}
record Person(name: string, age: i32);
help(Signatures);
help(Person);
help(UnionConstructor);

