class Counter {
    public var value = 1;
    public static var staticValue = 1;
    public constructor() {}
    public func next() i32 { return this.value++; }
    public static func staticFunc() i32 { return Counter.staticValue++; }
    func hidden() i32 { return 0; }
}
const counter = new Counter();
print(dir(Counter));
print(dir(counter));
help(Counter);
help(counter);

