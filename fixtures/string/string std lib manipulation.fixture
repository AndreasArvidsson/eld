print("padStart / padEnd");
print("0.1".padStart(4, "0"));
print("0.1".padEnd(4, "0"));
print();

print("replace / replaceAll");
print("hello world".replace("o", "_"));
print("hello world".replaceAll("o", "_"));
print();

print("repeat / reverse");
print("a_".repeat(3));
print("a_".repeat(0));
print("hello world".reverse());
print("a😀b".reverse());

