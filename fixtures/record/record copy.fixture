record Options(name: string, value: i32) {
    public func label() string {
        return f"{this.name}: {this.value}";
    }
}
record Measurement(total: i64, ratio: f64, note: string | null);

const original = new Options("foo", 10);
const updated = original.copy(value: 5);
const renamed = updated.copy(name: "bar");
const duplicate = renamed.copy();
const measurement = new Measurement(9_000_000_000, 1.5, null);
const adjusted = measurement.copy(ratio: 2.5);
print(original.name);
print(updated.value);
print(renamed.name);
print(duplicate.value);
print(updated.label());
print(adjusted.total);
print(adjusted.ratio);
print(adjusted.note);

