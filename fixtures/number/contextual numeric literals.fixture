const z = x + y;
const f = 1.5 + 2.5;
const g: f32 = 1.5 + 2.5;
const h: f32 = 3.141592653589793;
const j = h + 2.0;
const reverse = 2.0 + h;
const widths: i64[] = [3_000_000_000, 1];
const branch: i64 = true ? 3_000_000_000 : 1;
const conditional: i64 = if (true) {
    yield 3_000_000_000;
}
else {
    yield 1;
};
const selection: i64 = switch (1) {
    case 1 => 3_000_000_000
    else => 1
};
const minimum: i64 = -9_223_372_036_854_775_808;
print(d);
print(z);
print(g);
print(j);
print(reverse);
print(widths[0]);
print(branch);
print(conditional);
print(selection);
print(minimum);

