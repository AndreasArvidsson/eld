const decimal = 123;
const separated = 1_000_000;
const hex = 0xFF;
const hexSeparated: i64 = 0xCAFE_BABE;
const binary = 0b1010;
const binarySeparated = 0b1111_0000;
const upper = 0XAB + 0B11;
const wide: i64 = 0x7FFF_FFFF_FFFF_FFFF;
const minimum: i64 = -0x8000_0000_0000_0000;
const minimum32: i32 = -0x8000_0000;
func matches(value: 0xFF) bool { return value == 255; }
print(decimal);
print(separated);
print(hex);
print(hexSeparated);
print(binary);
print(binarySeparated);
print(upper);
print(wide);
print(minimum);
print(minimum32);
print(matches(0b1111_1111));

