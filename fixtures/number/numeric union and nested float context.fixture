const small: i8 = 1;
const medium: i16 = 2;
const wide: i64 = 3;
const smallUnion: i8 | i16 = small;
const mediumUnion: i8 | i16 = medium;
const narrowResult = true ? smallUnion : medium;
const smallResult = true ? smallUnion : wide;
const mediumResult = true ? mediumUnion : wide;
const single: f32 = 1.5;
const double: f64 = 2.5;
const floatingUnion: f32 | f64 = single;
const widenedFloat = true ? floatingUnion : double;
const mixedUnion: i8 | f32 = small;
const mixedResult = true ? mixedUnion : wide;
const mixedFloatUnion: i8 | f32 = single;
const mixedFloatResult = true ? mixedFloatUnion : wide;
const nullableSmall: i8 | null = small;
const nullableEmpty: i8 | null = null;
const nullableResult = true ? nullableSmall : wide;
const nullableEmptyResult = true ? nullableEmpty : wide;
const nested = single + (2.0 + 3.0);
const reverseNested = (2.0 + 3.0) + single;
print(smallResult);
print(narrowResult);
print(mediumResult);
print(widenedFloat);
print(mixedResult);
print(mixedFloatResult);
print(nullableResult);
print(nullableEmptyResult);
print(nested);
print(reverseNested);

