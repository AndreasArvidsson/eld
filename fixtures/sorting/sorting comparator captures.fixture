func comparator() Comparator<i32> {
    var direction = 1;
    const cmp: Comparator<i32> = (a, b) => direction * a.compareTo(b);
    direction = -1;
    return cmp;
}
class Direction {
    const multiplier = 1;
    public func comparator() Comparator<i32> {
        return (a, b) => {
            return this.multiplier * a.compareTo(b);
        };
    }
}
const values: List<i32> = [3, 1, 2];
values.sort(comparator());
print(values);
values.sort(new Direction().comparator());
print(values);

