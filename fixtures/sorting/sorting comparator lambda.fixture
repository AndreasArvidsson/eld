class Person {
    public const age: i32;
    public constructor(age: i32) { this.age = age; }
}
const people: List<Person> = [new Person(30), new Person(10), new Person(20)];
const byAge: Comparator<Person> = (a, b) => a.age.compareTo(b.age);
people.sort(byAge);
print(people.get(0).age);
print(people.get(1).age);
print(people.get(2).age);
people.sort((a, b) => b.age.compareTo(a.age));
print(people.get(0).age);
print(people.get(1).age);
print(people.get(2).age);

