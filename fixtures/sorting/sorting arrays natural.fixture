const bytes: i8[] = [3, 1, 2];
const shorts: i16[] = [3, 1, 2];
const ints: i32[] = [3, 1, 2];
const longs: i64[] = [3, 1, 2];
const floats: f32[] = [3.0, 1.0, 2.0];
const doubles: f64[] = [3.0, 1.0, 2.0];
const chars: char[] = ['c', 'a', 'b'];
const strings: [string] = ["c", "a", "b"];
bytes.sort(); shorts.sort(); ints.sort(); longs.sort();
floats.sort(); doubles.sort(); chars.sort(); strings.sort();
print(bytes); print(shorts); print(ints); print(longs);
print(floats); print(doubles); print(chars); print(strings);
const empty: [i32] = [];
empty.sort();
print(empty);

