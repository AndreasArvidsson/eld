class Person {
    public const age: i32;
    public constructor(age: i32) {
        this.age = age;
    }
}
class ByAge implements Comparator<Person> {
    public func compare(a: Person, b: Person) i32 {
        return a.age.compareTo(b.age);
    }
}
const people: List<Person> = [new Person(30), new Person(10), new Person(20)];
const byAge: Comparator<Person> = new ByAge();
people.sort(byAge);
print(people.get(0).age);
print(people.get(1).age);
print(people.get(2).age);

