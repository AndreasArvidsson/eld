class Person implements Comparable<Person> {
    public const age: i32;
    public constructor(age: i32) {
        this.age = age;
    }
    public func compareTo(other: Person) i32 {
        return this.age.compareTo(other.age);
    }
}
const people = new ArrayList<Person>();
people.add(new Person(30));
people.add(new Person(10));
people.add(new Person(20));
people.sort();
print(people.get(0).age);
print(people.get(1).age);
print(people.get(2).age);

