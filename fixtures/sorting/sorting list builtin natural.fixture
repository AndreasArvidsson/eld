bytes.sort(); shorts.sort(); ints.sort(); longs.sort();
floats.sort(); doubles.sort(); chars.sort(); strings.sort(); bools.sort();
print(bytes); print(shorts); print(ints); print(longs);
print(floats); print(doubles); print(chars); print(strings); print(bools);

