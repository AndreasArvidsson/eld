interface Order extends Comparable<Order> {
    const age: i32;
}
class Person implements Order {
    public const age: i32;
    public constructor(age: i32) { this.age = age; }
    public func compareTo(other: Order) i32 {
        return this.age.compareTo(other.age);
    }
}
class Child extends Person {
    public constructor(age: i32) {
        super(age);
    }
}
const people: List<Order> = [new Person(30), new Child(10), new Person(20)];
people.sort();
print(people.get(0).age);
print(people.get(1).age);
print(people.get(2).age);

