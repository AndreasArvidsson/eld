class Base {
    public const value: string;
    constructor(value: i32) { this.value = "private"; }
    protected constructor(value: string) { this.value = value; }
}
class Derived extends Base {
    public constructor() { this("protected"); }
    public constructor(value: string) { super(value); }
}
print(new Derived().value);
class OtherBase {
    public const value: i32;
    public constructor() { this(5); }
    public constructor(value: i32) { this.value = value; }
}
class OtherDerived extends OtherBase {}
print(new OtherDerived().value);

