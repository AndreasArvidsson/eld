class Value {
    public func value() i32 {
        return 1;
    }
}

class DetailedValue extends Value {
    public override func value() i32 {
        return 2;
    }
}

class Base {
    public func create() Value {
        return new Value();
    }
}

class Derived extends Base {
    public override func create() DetailedValue {
        return new DetailedValue();
    }
}

const derived = new Derived();
const base: Base = derived;
print(derived.create().value());
print(base.create().value());

