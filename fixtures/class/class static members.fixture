class Counter {
    public static var value = 40;

    public static func add(amount: i32 = 2) i32 {
        Counter.value = Counter.value + amount;
        return Counter.value;
    }
}

print(Counter.value);
print(Counter.add());
Counter.value = 7;
print(Counter.add(3));

