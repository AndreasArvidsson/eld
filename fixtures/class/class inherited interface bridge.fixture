class Value {
    public func number() i32 {
        return 1;
    }
}

class DetailedValue extends Value {
    public override func number() i32 {
        return 2;
    }
}

interface Reader {
    func read() Value;
}

class Base implements Reader {
    public func read() DetailedValue {
        return new DetailedValue();
    }
}

class Child extends Base {}

const reader: Reader = new Child();
print(reader.read().number());

