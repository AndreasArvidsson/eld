class Example {
    public static var value = 0;

    public static func consume(value: i32) {
        print(value);
    }

    public static async func run() {
        Example.consume(await Promise.resolve(40));
        Example.value = await Promise.resolve(42);
        print(Example.value);
    }
}

ignore Example.run();

