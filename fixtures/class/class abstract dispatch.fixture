abstract class Base {
    public abstract func value() i32;
    public func doubled() i32 {
        return this.value() * 2;
    }
}

class Child extends Base {
    public override func value() i32 {
        return 7;
    }
}

const instance: Base = new Child();
print(instance.doubled());

