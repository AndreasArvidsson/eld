class Example {
    static async func privateValue() i32 {
        return await Promise.resolve(40);
    }

    protected static async func protectedValue() i32 {
        return await Promise.resolve(2);
    }

    public static async func value() i32 {
        return await Example.privateValue();
    }
}

async func run() {
    print(await Example.value());
}
ignore run();

