class Base {
    protected var value: i64;
    protected constructor(value: i64, extra: i64 = value + 1) {
        this.value = value + extra;
    }
    public func read() i64 {
        return this.value;
    }
}
class Child extends Base {
    public constructor(value: i32 = 4) {
        super(value);
    }
}
print(new Child().read());
print(new Child(6).read());

