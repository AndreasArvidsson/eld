class Base {
    protected var value: i32;
    protected constructor(a: i32 = 1, *, b: i32) {
        this.value = a * 10 + b;
    }
    public func read() i32 {
        return this.value;
    }
}
class Child extends Base {
    public constructor() {
        super(b: 4, a: 2);
    }
}
class DefaultChild extends Base {
    public constructor() {
        super(b: 7);
    }
}
print(new Child().read());
print(new DefaultChild().read());

