class Base {
    public func describe(value: i32) string { return "base"; }
}

class Child extends Base {
    public override func describe(value: i32) string { return "child"; }
    public func describe(value: string) string { return "string"; }
}

const child = new Child();
const base: Base = child;
print(child.describe(2));
print(child.describe("hello"));
print(base.describe(2));

