class Base {
    public func describe(values: List<i32>) string { return "base integer"; }
    public func describe(values: List<string>) string { return "base string"; }
}

class Child extends Base {
    public override func describe(values: List<i32>) string { return "child integer"; }
}

const child: Base = new Child();
const integers: List<i32> = new ArrayList<i32>();
const strings: List<string> = new ArrayList<string>();
print(child.describe(integers));
print(child.describe(strings));

