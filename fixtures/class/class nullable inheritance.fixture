class Base {}
class Child extends Base {}
class Sibling extends Base {}

func widen(value: Child | null) Base | null {
    return value;
}
func accepts(value: Base | null) bool {
    return value != null;
}
func multi(choice: i32) Base | null {
    var value: Child | Sibling | null = null;
    if (choice == 1) {
        value = new Child();
    }
    elif (choice == 2) {
        value = new Sibling();
    }
    return value;
}

var child: Child | null = new Child();
const base: Base | null = child;
print(base == child);
print(widen(child) == base);
print(accepts(child));
child = null;
const absent: Base | null = child;
print(absent == null);
print(widen(child) == null);
print(accepts(child));
print(multi(0) == null);
print(multi(1) != null);
print(multi(2) != null);

