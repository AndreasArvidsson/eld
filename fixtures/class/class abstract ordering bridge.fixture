abstract class Base implements Comparable<Base> {
    public func compareTo(other: Base) i32 {
        return 7;
    }
}

class Child extends Base {}

const comparable: Comparable<Base> = new Child();
print(comparable.compareTo(new Child()));

abstract class Ordering implements Comparator<Base> {
    public func compare(a: Base, b: Base) i32 {
        return 8;
    }
}

class ChildOrdering extends Ordering {}

const comparator: Comparator<Base> = new ChildOrdering();
print(comparator.compare(new Child(), new Child()));

