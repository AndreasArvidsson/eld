class Value {
    public const value: i32;
    public constructor(value: i32 = 1) { this.value = value; }
    public constructor(a: i32, b: i32) { this.value = a + b; }
    public constructor(enabled: bool) { this(); }
}
print(new Value().value);
print(new Value(5).value);
print(new Value(3, 4).value);
print(new Value(true).value);
help(Value);
class Named {
    public const value: string;
    constructor(value: i32, *, label: string = "default") { this.value = f"{label}: {value}"; }
    public constructor(enabled: bool) { this(label: "named", value: 7); }
    public constructor(value: string) { this(9); }
}
print(new Named(true).value);
print(new Named("text").value);

