class Foo {
    public var value: i32;
    public constructor(value: i32) {
        this.value = value;
    }
    public func getValue() i32 {
        return this.value;
    }
}

const foo = new Foo(5);
print(foo.value);
foo.value++;
print(foo.getValue());

