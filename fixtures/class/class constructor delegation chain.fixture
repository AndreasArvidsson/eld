var initializations = 0;
func initialize() i32 { initializations += 1; return 3; }
class Base {
    public const baseValue: i32;
    public constructor(value: i32) { this.baseValue = value; }
    public constructor(value: string) { this.baseValue = value.length; }
}
class Derived extends Base {
    public var marker = initialize();
    public const value: i32;
    public constructor() { this("hello"); }
    public constructor(value: string) { this(value.length, true); }
    constructor(value: i32, enabled: bool) {
        super(value);
        this.value = value;
    }
}
const derived = new Derived();
print(derived.value);
print(derived.baseValue);
print(derived.marker);
print(initializations);
print(new Base("abc").baseValue);
help(Derived);

