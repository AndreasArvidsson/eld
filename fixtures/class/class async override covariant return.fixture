class Value {
    public func value() i32 {
        return 1;
    }
}

class DetailedValue extends Value {
    public override func value() i32 {
        return 2;
    }
}

class Base {
    public async func create() Value {
        return new Value();
    }
}

class Derived extends Base {
    public override async func create() DetailedValue {
        return new DetailedValue();
    }
}

async func run() {
    const base: Base = new Derived();
    print((await base.create()).value());
}

ignore run();

