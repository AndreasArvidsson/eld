class Value {
    public const kind: string;
    public constructor(value: i32) { this.kind = "i32"; }
    public constructor(value: i64) { this.kind = "i64"; }
    public constructor(value: string) { this.kind = "string"; }
    public constructor(value: string | null) { this.kind = "nullable"; }
    public constructor(value: () => i32) { this.kind = f"function: {value()}"; }
}
print(new Value(1).kind);
print(new Value(2147483648).kind);
print(new Value("text").kind);
print(new Value(null).kind);
print(new Value(() => 3).kind);
class Named {
    public const value: i32;
    public constructor(*, first: i32) { this.value = first; }
    public constructor(*, second: i32) { this.value = second + 1; }
}
print(new Named(first: 2).value);
print(new Named(second: 2).value);

