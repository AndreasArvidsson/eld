interface Calls {
    func foo(*, a: i32) i32;
    func foo(*, b: i32) i32;
}

class Impl implements Calls {
    public func foo(*, a: i32) i32 { return a + 1; }
    public func foo(*, b: i32) i32 { return b + 2; }
}

const calls: Calls = new Impl();
print(calls.foo(a: 1));
print(calls.foo(b: 2));

