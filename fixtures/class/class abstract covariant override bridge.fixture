class Value {
    public func number() i32 {
        return 1;
    }
}

class DetailedValue extends Value {
    public override func number() i32 {
        return 2;
    }
}

class Base {
    public func create() Value {
        return new Value();
    }
}

abstract class Deferred extends Base {
    public abstract override func create() DetailedValue;
}

class Child extends Deferred {
    public override func create() DetailedValue {
        return new DetailedValue();
    }
}

const base: Base = new Child();
print(base.create().number());

