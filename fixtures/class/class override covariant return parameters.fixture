class Value {
    public func value() i32 {
        return 1;
    }
}

class DetailedValue extends Value {
    public override func value() i32 {
        return 2;
    }
}

class Base {
    public func create(reference: Value, count: i32, wide: i64, ratio: f64) Value {
        return new Value();
    }
}

class Derived extends Base {
    public override func create(reference: Value, count: i32, wide: i64, ratio: f64) DetailedValue {
        return new DetailedValue();
    }
}

const base: Base = new Derived();
const wide: i64 = 2;
const ratio: f64 = 3.0;
print(base.create(new Value(), 1, wide, ratio).value());

