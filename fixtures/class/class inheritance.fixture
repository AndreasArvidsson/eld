class Base {
    protected var value: i32;
    protected constructor(value: i32 = 4) {
        this.value = value;
    }
    public func read() i32 {
        return this.value;
    }
}
class Child extends Base {
    public func read() i32 {
        return this.value + 2;
    }
    public func reference() () => i32 {
        return () => this.read();
    }
}
const instance: Base = new Child();
print(instance.read());
print(new Child().reference()());

