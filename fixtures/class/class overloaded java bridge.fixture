class Direct implements Comparable<Direct> {
    public func compareTo(other: Direct) i32 { return 1; }
    public func compareTo(other: any) i32 { return 2; }
}
const direct = new Direct();
const directContract: Comparable<Direct> = direct;
print(direct.compareTo(new Direct()));
print(direct.compareTo("text"));
print(directContract.compareTo(new Direct()));

class Base {
    public func compareTo(other: any) i32 { return 4; }
}
class Derived extends Base implements Comparable<Derived> {
    public func compareTo(other: Derived) i32 { return 3; }
}
const derived = new Derived();
const derivedContract: Comparable<Derived> = derived;
print(derived.compareTo(new Derived()));
print(derived.compareTo("text"));
print(derivedContract.compareTo(new Derived()));

class Ordering implements Comparator<Ordering> {
    public func compare(left: Ordering, right: Ordering) i32 { return 5; }
    public func compare(left: any, right: any) i32 { return 6; }
}
const ordering = new Ordering();
const orderingContract: Comparator<Ordering> = ordering;
print(ordering.compare(new Ordering(), new Ordering()));
print(ordering.compare("a", "b"));
print(orderingContract.compare(new Ordering(), new Ordering()));

