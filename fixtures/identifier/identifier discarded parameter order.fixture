func discardFirst(_: i32, next: i32) i32 {
    return next;
}
print(discardFirst(1, 2));

const discardLambda: (i32, i32) => i32 = (_, next) => next;
print(discardLambda(1, 2));

class DiscardCtor {
    public var value: i32;
    public constructor(_: i32, next: i32) {
        this.value = next;
    }
}
print(new DiscardCtor(1, 2).value);

func discardDefault(_: i32 = 1, next: i32 = 2) i32 {
    return next;
}
print(discardDefault());

func discardOptional(_?: i32, next: i32 = 2) i32 {
    return next;
}
print(discardOptional());

async func discardAsync(_: i32, next: i32) i32 {
    const value = await Promise.resolve(next);
    return value;
}
async func printDiscardAsync() {
    print(await discardAsync(1, 2));
}
ignore printDiscardAsync();

