class Compare {
    public static func equal(a: Compare, b: Compare) bool { return true; }
    public func marker() string { return "x"; }
}

func unsafe(value: Compare | null) {
    const compare = new Compare();
    if (compare == value) {
        print(value.marker());
    }
}
unsafe(null);
unsafe(new Compare());

