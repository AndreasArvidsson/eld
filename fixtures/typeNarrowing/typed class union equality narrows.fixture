class Animal {
    public static func equal(a: Animal, b: Animal) bool { return true; }
}
class Cat extends Animal {
    public func meow() string { return "meow"; }
}
class Dog extends Animal {}

func inspect(value: Cat | Dog, cat: Cat) {
    if (value == cat) {
        print(value.meow());
    }
}

inspect(new Dog(), new Cat());

