class Animal {}
class Cat extends Animal {
    public static func equal(a: Cat, b: Cat) bool { return true; }
    public func meow() string { return "meow"; }
}
class Dog extends Animal {}

func inspectUnion(value: Cat | Dog, cat: Cat) {
    if (value == cat) {
        print(value.meow());
    }
}

inspectUnion(new Cat(), new Cat());

