interface Base {}
class DerivedA implements Base {}
class DerivedB implements Base {}
const value: Base = new DerivedA();

if (value instanceof DerivedA) {
    print(value.getClass().getSimpleName());
}
elif (value instanceof DerivedB) {
    print(value);
}
else {
    print(value);
}

