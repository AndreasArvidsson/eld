class Base {}
class DerivedA extends Base {
    public func label() string { return "A"; }
}
class DerivedB extends Base {}
var value: Base = new DerivedA();
func change() Type<DerivedA> {
    value = new DerivedB();
    return DerivedA;
}
if (value instanceof change()) {
    print(value.label());
}

