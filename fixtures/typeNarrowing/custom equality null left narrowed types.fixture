class Compare {
    public static func equal(a: Compare, b: Compare) bool { return true; }
    public func marker() string { return "x"; }
}

const value: Compare | null = new Compare();
if (null == value) {
    print(value);
}
else {
    print(value.marker());
}
if (value != null) {
    print(value.marker());
}

