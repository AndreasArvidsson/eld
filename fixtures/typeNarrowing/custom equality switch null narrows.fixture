class Compare {
    public static const func equal(a: Compare, b: Compare) bool { return true; }
    public const override func hashCode() i32 { return 0; }
}

func unsafe(value: Compare | null) {
    switch (value) {
        case null { const narrowed: null = value; }
        else => print("other")
    }
}

