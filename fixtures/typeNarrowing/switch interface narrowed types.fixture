interface Base {}
class DerivedA implements Base {}
class DerivedB implements Base {}
const value: Base = new DerivedA();

switch (value) {
    case DerivedA => print(value.getClass().getSimpleName())
    case DerivedB => print(value)
    else => print(value)
}

