class Animal {}
class Cat extends Animal {
    public static func equal(a: Cat, b: Cat) bool { return true; }
    public func meow() string { return "meow"; }
}
class Dog extends Animal {}

func inspect(value: Animal, cat: Cat) {
    if (value == cat) {
        print(value.meow());
    }
}

inspect(new Cat(), new Cat());

