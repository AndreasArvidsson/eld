class Box {
    public static func equal(a: Box, b: Box) bool {
        return true;
    }
}

const first = new Box();
const second = new Box();

print(first == first);
print(first == second);
const equal: (Box, Box) => bool = Box.equal;
print(equal(first, second));
print(first.hashCode() == first.hashCode());
print(first.toString() == first.toString());

