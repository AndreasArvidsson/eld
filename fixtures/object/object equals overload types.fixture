class Foo {
    public func equals(value: i32) bool {
        return value == 1;
    }
}

const foo = new Foo();
print(foo.equals(1));
print(foo.equals("x"));
print(foo.equals(foo));
print(foo.equals(new Foo()));
print(foo.equals(value: 1));

