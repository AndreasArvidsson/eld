class PrivateFoo {
    func toString(value: i32) string {
        return "private";
    }
    public func check() string {
        return this.toString(1);
    }
}
class StaticFoo {
    public static func toString(value: i32) string {
        return "static";
    }
}

const privateFoo = new PrivateFoo();
const staticFoo = new StaticFoo();
print(privateFoo.check());
print(privateFoo.toString().startsWith("Test$PrivateFoo@"));
print(StaticFoo.toString(1));
print(staticFoo.toString().startsWith("Test$StaticFoo@"));

