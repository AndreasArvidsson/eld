class Value {
    public var toString = "field";
    public var hashCode = 42;
    public override func toString() string { return "method"; }
}
const value = new Value();
print(value.toString);
class Inherited {
    public var toString = "inherited field";
}
const inherited = new Inherited();
print(inherited.toString);
const inheritedText: () => string = inherited.toString;
print(inherited.toString() == inheritedText());
print(value.toString());
const text: () => string = value.toString;
print(text());
print(value.hashCode);
print(value.hashCode() == value.hashCode());
const hash: () => i32 = value.hashCode;
print(hash() == value.hashCode());
value.toString = "updated";
print(value.toString);

