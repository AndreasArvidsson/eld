class MutableFoo {
    public var value = 0;
    public func equals(value: i32) bool {
        this.value++;
        return true;
    }
}
class PrivateFoo {
    func equals(value: i32) bool {
        return true;
    }
}
class StaticFoo {
    public static func equals(value: i32) bool {
        return true;
    }
}

const mutable: const MutableFoo = new MutableFoo();
const privateFoo = new PrivateFoo();
const staticFoo = new StaticFoo();
print(mutable.equals("x"));
print(privateFoo.equals("x"));
print(StaticFoo.equals(1));
print(staticFoo.equals("x"));

