interface Match {}
class MatchImpl implements Match {}
class Foo {
    public func equals(value: Match) bool {
        return true;
    }
}

const foo = new Foo();
print(foo.equals(new MatchImpl()));
print(foo.equals(true ? new MatchImpl() : new MatchImpl()));
print(foo.equals(true ? "x" : "y"));
print(foo.equals(true ? new MatchImpl() : "y"));

