record Point(x: i32, y: i32);

const point = new Point(1, 2);
const equals: (any) => bool = point.equals;
const hashCode: () => i32 = point.hashCode;
const toString: () => string = point.toString;

print(equals(new Point(1, 2)));
print(hashCode() == point.hashCode());
print(toString());

