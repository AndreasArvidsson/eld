class Animal {
    public static func equal(a: Animal, b: Animal) bool { return true; }
}
class Cat extends Animal {
    public func equals(value: i32) bool { return value == 1; }
}
const cat = new Cat();
print(cat.equals(1));
print(cat == cat);
print(cat == new Cat());
print(new Cat() == new Cat());

