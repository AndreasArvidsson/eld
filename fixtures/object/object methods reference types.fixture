print(array.toString());
print(tuple.equals((1, true)));
print(function.hashCode() == function.hashCode());
print(promise.equals(promise));
print(source.equals(source));
print(print.equals(print));
print(dir.equals(dir));
print(help.equals(help));
print(regex.toString() == "x");

