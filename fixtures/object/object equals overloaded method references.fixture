class Foo {
    public func toString(value: i32) string {
        return f"value: {value}";
    }
}

const foo = new Foo();
const inherited: () => string = foo.toString;
const numeric: (i32) => string = foo.toString;
print(inherited().startsWith("Test$Foo@"));
print(numeric(1));

