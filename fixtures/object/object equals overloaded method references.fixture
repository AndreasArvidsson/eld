class Foo {
    public func equals(value: i32) bool {
        return value == 1;
    }
}

const foo = new Foo();
const numeric: (i32) => bool = foo.equals;
const inherited: (any) => bool = foo.equals;
print(numeric(1));
print(inherited("x"));
print(inherited(foo));

