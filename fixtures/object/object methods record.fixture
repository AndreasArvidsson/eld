record Point(x: i32, y: i32);

const first = new Point(1, 2);
const second = new Point(1, 2);

print(first.equals(second));
print(first == second);
const dynamicFirst: any = first;
const dynamicSecond: any = second;
print(dynamicFirst == dynamicSecond);
print(first.hashCode() == second.hashCode());
print(first.toString());

