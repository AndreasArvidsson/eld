interface Text {
    func toString(value: i32) string;
    func toString(value: string) string;
}
class Foo implements Text {
    public func toString(value: i32) string { return f"number: {value}"; }
    public func toString(value: string) string { return f"text: {value}"; }
    public func hashCode(value: i32) i32 { return value; }
}
const foo = new Foo();
const numeric: (i32) => string = foo.toString;
const text: (string) => string = foo.toString;
const inherited: () => string = foo.toString;
const hash: () => i32 = foo.hashCode;
const hashWithArgument: (i32) => i32 = foo.hashCode;
const contract: Text = foo;
const interfaceNumeric: (i32) => string = contract.toString;
const interfaceInherited: () => string = contract.toString;
print(numeric(1));
print(text("hello"));
print(inherited().startsWith("Test$Foo@"));
print(hash() == foo.hashCode());
print(hashWithArgument(7));
print(interfaceNumeric(2));
print(interfaceInherited().startsWith("Test$Foo@"));

