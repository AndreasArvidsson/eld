interface Reader {
    read() i32;
}
class Box {
    var value = 9;
    public func make() Reader {
        return {
            read: () => {
                const inner: Reader = {
                    read: () => this.value
                };
                return inner.read();
            }
        };
    }
}
const box = new Box();
const reader = box.make();
print(reader.read());

