interface Tri {
    func describe(values: List<bool>) string;
    func describe(values: List<i32>) string;
    func describe(values: List<string>) string;
}
class Base {
    public func describe(values: List<i32>) string { return "integers"; }
    public func describe(values: List<string>) string { return "strings"; }
}
class Child extends Base implements Tri {
    public func describe(values: List<bool>) string { return "booleans"; }
}
const child = new Child();
const contract: Tri = child;
const booleans: List<bool> = new ArrayList<bool>();
const ints: List<i32> = new ArrayList<i32>();
const strings: List<string> = new ArrayList<string>();
print(child.describe(booleans));
print(child.describe(ints));
print(child.describe(strings));
print(contract.describe(booleans));
print(contract.describe(ints));
print(contract.describe(strings));

