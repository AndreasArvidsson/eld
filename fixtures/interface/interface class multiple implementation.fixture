interface Value {
    const value: i32;
}
interface Flag {
    const flag: bool;
}
class Box implements Value, Flag {
    public const value = 7;
    public const flag = true;
}
const box = new Box();
const value: Value = box;
const flag: Flag = box;
print(value.value);
print(flag.flag);

