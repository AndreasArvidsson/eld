interface Box {
    var toString: string;
}
class Value implements Box {
    public var toString = "box";
}
const box: Box = new Value();
print(box.toString);
print(box.toString().startsWith("Test$Value@"));
const same: () => string = box.toString;
print(same().startsWith("Test$Value@"));
box.toString = "updated";
print(box.toString);

