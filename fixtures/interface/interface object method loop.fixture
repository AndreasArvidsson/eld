interface Calculator {
    calculate(value: i32) i32;
}
const calculator: Calculator = {
    calculate: (value) => {
        var result = value;
        for (var i = 0; i < 3; i++) {
            result = result * 2;
        }
        return result;
    }
};
print(calculator.calculate(2));

