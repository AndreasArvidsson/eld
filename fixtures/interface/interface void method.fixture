interface Renamable {
    func rename(name: string);
}
class Person implements Renamable {
    public var name = "Bob";
    public func rename(name: string) {
        this.name = name;
    }
}
const person = new Person();
const action: Renamable = person;
action.rename("Alice");
print(person.name);

