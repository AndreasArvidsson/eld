interface I {
    func f(x?: string) string;
    func f(x: string | null, y: i32) string;
}
class C implements I {
    public func f(x?: string) string { return "one"; }
    public func f(x: string | null, y: i32) string { return "two"; }
}
const value: I = new C();
print(value.f());
print(value.f("a", 2));

