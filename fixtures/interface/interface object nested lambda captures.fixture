interface Reader {
    func read() i32;
}
func make(start: i32) Reader {
    var count = start;
    const offset = 2;
    return {
        read: () => {
            count++;
            const nested: () => i32 = () => count + offset;
            return nested();
        }
    };
}
const reader = make(13);
print(reader.read());
print(reader.read());

