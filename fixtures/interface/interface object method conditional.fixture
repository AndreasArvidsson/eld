interface Calculator {
    func calculate(value: i32) i32;
}
const calculator: Calculator = {
    calculate: (value) => {
        var result = value;
        if (result > 10) {
            result = result - 1;
        }
        return result;
    }
};
print(calculator.calculate(16));
print(calculator.calculate(8));

