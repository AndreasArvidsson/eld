interface Overloaded {
    func f(values: List<i32>) string;
    func f(values: List<string>) string;
}
interface Single {
    func f(values: List<i32>) string;
}
class Both implements Overloaded, Single {
    public func f(values: List<i32>) string { return "integers"; }
    public func f(values: List<string>) string { return "strings"; }
}
const overloaded: Overloaded = new Both();
const single: Single = new Both();
print(overloaded.f(new ArrayList<i32>()));
print(overloaded.f(new ArrayList<string>()));
print(single.f(new ArrayList<i32>()));

