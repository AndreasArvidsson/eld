interface I { func compareTo(other: any) i32; }
class C implements I, Comparable<C> {
    public func compareTo(other: any) i32 { return 2; }
    public func compareTo(other: C) i32 { return 1; }
}
const c = new C();
const i: I = c;
const java: Comparable<C> = c;
print(i.compareTo("x"));
print(java.compareTo(new C()));

