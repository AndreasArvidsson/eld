interface First {}
interface Second {}

class Combined implements First, Second {}

interface FirstFactory {
    func create() First;
}

interface SecondFactory {
    func create() Second;
}

class Factory implements FirstFactory, SecondFactory {
    public func create() Combined {
        return new Combined();
    }
}

const first: FirstFactory = new Factory();
const second: SecondFactory = new Factory();
const firstValue = first.create();
const secondValue = second.create();
print(firstValue.equals(firstValue));
print(secondValue.equals(secondValue));

