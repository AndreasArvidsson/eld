interface Reader {
    func read() i32;
}

interface NamedReader extends Reader {
    const name: string;
}

class Impl implements NamedReader {
    public const name = "reader";

    public func read() i32 {
        return 7;
    }
}

const reader: Reader = new Impl();
print(reader.read());

