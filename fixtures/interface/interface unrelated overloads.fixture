interface Integers {
    func describe(value: i32) string;
}
interface Strings {
    func describe(value: string) string;
}
class Both implements Integers, Strings {
    public func describe(value: i32) string { return "integers"; }
    public func describe(value: string) string { return "strings"; }
}
const integers: Integers = new Both();
const strings: Strings = new Both();
print(integers.describe(2));
print(strings.describe("x"));

