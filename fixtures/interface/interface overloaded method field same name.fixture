interface Value {
    const f: i32;
    func f(value: i32) i32;
    func f(value: string) i32;
}
class Impl implements Value {
    public const f = 7;
    public func f(value: i32) i32 { return value; }
    public func f(value: string) i32 { return 2; }
}
const value: Value = new Impl();
print(value.f);
print(value.f(3));
print(value.f("x"));

