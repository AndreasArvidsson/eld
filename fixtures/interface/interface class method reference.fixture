interface Reader {
    func read() i32;
}
class Box implements Reader {
    public var value: i32;
    public constructor(value: i32) {
        this.value = value;
    }
    public func read() i32 {
        return this.value;
    }
}
var reader: Reader = new Box(1);
const read = reader.read;
reader = new Box(2);
print(read());
print(reader.read());

