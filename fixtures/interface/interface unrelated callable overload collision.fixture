interface IntMapper {
    func describe(mapper: (i32) => string) string;
}
interface StringMapper {
    func describe(mapper: (string) => string) string;
}
class Both implements IntMapper, StringMapper {
    public func describe(mapper: (i32) => string) string { return "integers"; }
    public func describe(mapper: (string) => string) string { return "strings"; }
}

