interface Foo {
    const immutable: i32;
    var mutable: i32;
}
const foo: Foo = {
    immutable: 1,
    mutable: 2
};
print(foo.mutable = 3);
print(foo.mutable++);
print(foo.mutable);
print(foo.mutable--);
print(foo.mutable);
print(foo.immutable);

