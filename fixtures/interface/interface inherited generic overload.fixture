interface BasePrinter {
    func describe(values: List<i32>) string;
    func describe(values: List<string>) string;
}
interface Printer extends BasePrinter {
    func describe(values: List<bool>) string;
}
class Both implements Printer {
    public func describe(values: List<bool>) string { return "bools"; }
    public func describe(values: List<string>) string { return "strings"; }
    public func describe(values: List<i32>) string { return "integers"; }
}
const printer: Printer = new Both();
const integers: List<i32> = new ArrayList<i32>();
const strings: List<string> = new ArrayList<string>();
const bools: List<bool> = new ArrayList<bool>();
print(printer.describe(integers));
print(printer.describe(strings));
print(printer.describe(bools));

