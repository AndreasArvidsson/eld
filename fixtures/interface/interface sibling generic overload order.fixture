interface A {
    func describe(values: List<i32>) string;
    func describe(values: List<string>) string;
}
interface B {
    func describe(values: List<string>) string;
    func describe(values: List<i32>) string;
}
class Root {}
class First extends Root implements A {
    public func describe(values: List<i32>) string { return "first ints"; }
    public func describe(values: List<string>) string { return "first strings"; }
}
class Second extends Root implements B {
    public func describe(values: List<i32>) string { return "second ints"; }
    public func describe(values: List<string>) string { return "second strings"; }
}
const first: A = new First();
const second: B = new Second();
const ints: List<i32> = new ArrayList<i32>();
const strings: List<string> = new ArrayList<string>();
print(first.describe(ints));
print(first.describe(strings));
print(second.describe(ints));
print(second.describe(strings));

