interface Counter {
    func add(value: i32) i32;
    func read() i32;
}
func make(start: i32) Counter {
    var count = start;
    return {
        add: (value) => {
            count = count + value;
            return count;
        },
        read: () => count
    };
}
const counter = make(10);
print(counter.add(3));
print(counter.read());
print(counter.add(4));

