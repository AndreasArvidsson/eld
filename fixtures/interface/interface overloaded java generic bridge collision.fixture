interface I { func compareTo(other: List<string>) i32; }
class C implements I, Comparable<List<i32>> {
    public func compareTo(other: List<i32>) i32 { return 1; }
    public func compareTo(other: List<string>) i32 { return 2; }
}
const c = new C();
const i: I = c;
const java: Comparable<List<i32>> = c;
print(i.compareTo(new ArrayList<string>()));
print(java.compareTo(new ArrayList<i32>()));

