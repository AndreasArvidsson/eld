interface Box {
    var equals: i32;
}
class Value implements Box {
    public var equals = 1;
}
const box: Box = new Value();
print(box.equals);
print(box.equals(box));
const same: (Box) => bool = box.equals;
print(same(box));
print(same(new Value()));
box.equals = 2;
print(box.equals);

