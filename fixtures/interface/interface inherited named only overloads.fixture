interface A {
    func pick(*, a: i32) i32;
}
interface B {
    func pick(*, b: i32) i32;
}
interface C extends A, B {}

class Both implements C {
    public func pick(*, a: i32) i32 { return a + 1; }
    public func pick(*, b: i32) i32 { return b + 10; }
}

const value: C = new Both();
print(value.pick(a: 1));
print(value.pick(b: 2));

