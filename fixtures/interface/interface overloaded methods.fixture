interface Printer {
    func describe(value: i32) string;
    func describe(value: string) string;
}
class Both implements Printer {
    public func describe(value: string) string { return "text"; }
    public func describe(value: i32) string { return "number"; }
}
const printer: Printer = new Both();
print(printer.describe(2));
print(printer.describe("x"));
const integerMethod: (i32) => string = printer.describe;
const stringMethod: (string) => string = printer.describe;
print(integerMethod(3));
print(stringMethod("y"));

