class Value {
    public func value() i32 {
        return 1;
    }
}

class DetailedValue extends Value {
    public override func value() i32 {
        return 2;
    }
}

interface Factory {
    func create() Value;
}

interface DetailedFactory extends Factory {
    func create() DetailedValue;
}

class Impl implements DetailedFactory {
    public func create() DetailedValue {
        return new DetailedValue();
    }
}

const implementation = new Impl();
const factory: Factory = implementation;
const detailedFactory: DetailedFactory = implementation;
print(factory.create().value());
print(detailedFactory.create().value());

