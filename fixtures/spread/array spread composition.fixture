const first = [1, 2];
const second = [3, 4];
const empty: [i32] = [];
const values = [0, ...first, ...empty, ...second, 5,];
const only = [...first];
const onlyEmpty = [...empty];
const strings = [...["a"], "b", ...["c"]];
first[0] = 9;
print(values);
print(only);
print(onlyEmpty);
print(strings);
print(first);

