class Source {
    public var base = 7;
    public func value(n: i32 = this.base, extra: i64 = 2) i64 {
        return n + extra;
    }
}
const source = new Source();
const copy = {...source};
const again = {...copy};
source.base = 10;
print(copy.value());
print(copy.value(3));
print(copy.value(extra=5));
print(again.value());
print(again.value(1, 4));
interface Target {
    const base: i32; value(n: i32, extra: i64) i64;
}
const typed: Target = {...source};
print(typed.value(20, 3));

