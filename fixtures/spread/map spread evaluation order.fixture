var calls = 0;
const old = {"value": 10};
func spread(n: i32) Map<string, i32> {
    calls = calls * 10 + n;
    return old;
}
func value(n: i32) i32 {
    calls = calls * 10 + n;
    return n;
}
func property(n: i32) Map<string, i32> {
    return {"value": value(n)};
}
const result = {"value": value(1), ...spread(2), ...property(3), ...spread(4), ...property(5)};
print(calls);
print(result.get("value"));
print(old.get("value"));

