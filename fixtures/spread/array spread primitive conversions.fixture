const bytes: [i8] = [1, 2];
const shorts: [i16] = [3];
const longs: [i64] = [...bytes, ...shorts, 4];
const doubles: [f64] = [...longs, 5.0];
const floats: [f32] = [1.0];
const floating: [f64] = [...floats];
const chars: [char] = [...['a'], 'b'];
const flags: [bool] = [...[true], false];
const copiedBytes: [i8] = [...bytes];
const copiedShorts: [i16] = [...shorts];
const copiedFloats: [f32] = [...floats];
const boxed: [any] = [...bytes, ...flags];
print(longs);
print(doubles);
print(floating);
print(chars);
print(flags);
print(copiedBytes);
print(copiedShorts);
print(copiedFloats);
print(boxed);

