interface Base { var value: i32; }
interface Child extends Base { const name: string; }
const original: Child = {value: 1, name: "original"};
const copied = {...original};
copied.value = 2;
const typed: Child = {...copied, name: "typed"};
print([original.value, copied.value, typed.value]);
print([original.name, copied.name, typed.name]);

