interface Options { const name: string; const value: i32; }
const old: Options = { name: "foo", value: 10 };
const updated: Options = { ...old, value: 5 };
const overwritten: Options = { value: 5, ...old };
const inferred = { ...old, name: "Bob" };
const combined: Options = { ...old, ...updated, name: "last" };
const nested: Options = { ...{...old, name: "inner"}, value: 6 };
print([updated.value, overwritten.value, inferred.value, combined.value, old.value, nested.value]);
print([updated.name, inferred.name, combined.name, old.name, nested.name]);

