interface Options { const value: i32; }
var calls = 0;
var old: Options = { value: 10 };
func spread(n: i32) Options {
    calls = calls * 10 + n; return old;
}
func value(n: i32) i32 {
    calls = calls * 10 + n; return n;
}
func property(n: i32) Options {
    return { value: value(n) };
}
const result: Options = { value: value(1), ...spread(2), ...property(3), ...spread(4), ...property(5) };
print(calls);
print(result.value);
print(old.value);

