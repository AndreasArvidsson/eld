const old = {"name": "foo", "value": "10"};
const updated = {...old, "value": "5"};
const overwritten = {"value": "5", ...old};
const inferred = {...old, "name": "Bob"};
const combined = {...old, ...updated, "name": "last"};
const nested = {...{...old, "name": "inner"}, "value": "6"};
print(updated);
print(overwritten);
print(inferred);
print(combined);
print(old);
print(nested);


