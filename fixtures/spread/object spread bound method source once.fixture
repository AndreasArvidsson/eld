interface Method {
    func value() i32;
}
interface Field {
    const value: () => i32;
}
var calls = 0;
const old: Method = {
    value: () => 7
};
func source() Method {
    calls++; return old;
}
const copy: Field = {...source()};
print(calls);
print(copy.value());

