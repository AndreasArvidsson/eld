class Base { public const value = 7; }
class Child extends Base {}
class Sibling extends Base {}
const children = [new Child()];
const siblings = [new Sibling()];
const common = [...children, ...siblings];
const widened: [Base] = [...children];
const nested = [...[[1]], [2]];
const nullable: [i32 | null] = [...[1, 2], null];
print(common[0].value);
print(common[1].value);
print(widened[0].value);
print(nested);
print(nullable);

