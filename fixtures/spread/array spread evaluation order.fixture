var calls = 0;
const source = [1, 2];
func spread() [i32] { calls = calls * 10 + 2; return source; }
func value(n: i32) i32 { calls = calls * 10 + n; source[0] = n; return n; }
const result = [value(1), ...spread(), value(3), ...spread(), value(4)];
print(calls);
print(result);
print(source);

