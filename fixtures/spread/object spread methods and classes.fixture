interface Operation { const value: i32; add(n: i32) i32; }
const old: Operation = { value: 10, add: (n) => n + 1 };
const copied: Operation = { ...old, value: 5 };
const inferred = { ...copied };
const override: Operation = { ...old, add: (n) => n + 2 };
class Base { public const value = 20; const hidden = 1; }
class Child extends Base { public const other = 2; }
interface Value { const value: i32; const other: i32; }
const classCopy: Value = { ...new Child() };
interface Method { compute() i32; }
class MethodBase { public func compute() i32 { return 7; } }
class MethodChild extends MethodBase {}
const method: Method = { ...new MethodChild() };
print([copied.add(4), inferred.add(5), override.add(4), classCopy.value, classCopy.other, method.compute()]);

