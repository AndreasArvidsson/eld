var values = [2];

class Box {
    public var value = 3;
}
var box = new Box();

async func run() {
    var value = 1;
    (value++);
    (values[await Promise.resolve(0)]++);
    ((await Promise.resolve(box)).value++);
    print(value);
    print(values[0]);
    print(box.value);
}

ignore run();

