var values = [1, 2];
var index = 0;

class Box {
    public var value = 0;
}
var box = new Box();

func nextBox() Box {
    print("receiver");
    return box;
}

async func run() {
    values[index++] = await Promise.resolve(3);
    nextBox().value = await Promise.resolve(4);
    values[await Promise.resolve(index)] = await Promise.resolve(5);
    (await Promise.resolve(box)).value = 6;
    print(values);
    print(index);
    print(box.value);
}

ignore run();

