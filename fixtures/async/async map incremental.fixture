async func run() {
    const values = {
        "first": 1,
        "second": await Promise.resolve(2),
        await Promise.resolve("third"): 3,
        await Promise.resolve("fourth"): await Promise.resolve(4),
        ...await Promise.resolve({"fifth": 5}),
    };
    print(values);
}

ignore run();

