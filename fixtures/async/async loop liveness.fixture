async func run() {
    const whileBase = 10;
    var whileIndex = 0;
    while (whileIndex < 2) {
        print(whileBase + whileIndex);
        whileIndex++;
        await Promise.resolve();
    }

    const doBase = 20;
    var doIndex = 0;
    do {
        print(doBase + doIndex);
        doIndex++;
        await Promise.resolve();
    } while (doIndex < 2);

    const forBase = 30;
    for (var forIndex = 0; forIndex < 2; forIndex++) {
        print(forBase + forIndex);
        await Promise.resolve();
    }

    const eachBase = 40;
    for (item : [0, 1]) {
        print(eachBase + item);
        await Promise.resolve();
    }
}

ignore run();

