const values = [1];
const properties = {"value": 1};

func mutateValues() i32 {
    values[0] = 2;
    return 3;
}

func mutateProperties() i32 {
    properties.put("value", 2);
    return 4;
}

async func run() {
    const copiedValues = [
        ...values,
        await Promise.resolve(mutateValues()),
    ];
    const copiedProperties = {
        ...properties,
        "other": await Promise.resolve(mutateProperties()),
    };

    print(copiedValues);
    print(copiedProperties.get("value"));
    print(copiedProperties.get("other"));
    print(values);
    print(properties.get("value"));
}

ignore run();


