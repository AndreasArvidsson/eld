async func run() {
    var value = 1;
    await Promise.resolve();
    value++;
    await Promise.resolve();
    print(value);

    var sum = 0;
    for (var index = 0; index < 5; index++) {
        if (index == 1) {
            await Promise.resolve();
            continue;
        }
        await Promise.resolve();
        if (index == 4) {
            break;
        }
        sum = sum + index;
    }
    print(sum);

    var index = 0;
    while (index < 4) {
        index++;
        if (index == 1) {
            continue;
        }
        await Promise.resolve();
        if (index == 3) {
            break;
        }
        print(index);
    }
    print(index);

    for (item, itemIndex : [10, 20]) {
        await Promise.resolve();
        print(item + itemIndex);
    }
}

ignore run();

