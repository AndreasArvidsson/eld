var value = 1;
var values = [5];
var index = 0;
async func run() {
    var local = 1;
    local |= await Promise.resolve(2);
    value ^= await Promise.resolve(3);
    values[index++] &= await Promise.resolve(4);
    var wide: i64 = 1;
    wide <<= await Promise.resolve(65);
    var narrow: i8 = 1;
    var wideCount: i64 = 255;
    narrow |= await Promise.resolve(wideCount);
    var shifted: i64 = -1;
    shifted >>>= await Promise.resolve(wideCount);
    print(local);
    print(value);
    print(values[0]);
    print(index);
    print(wide);
    print(narrow);
    print(shifted);
}
ignore run();

