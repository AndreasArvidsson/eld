const first = new PromiseSource<i32>();
const second = new PromiseSource<i32>();

class Runner {
    public constructor() {}
    var value = 7;

    public async func run() {
        await second.promise;
        print(this.value);
    }
}

async func preserve(parameter: i32) {
    var local = parameter;
    if (local == 40) {
        print("before await");
        const value = await first.promise;
        print(value + local);
    }
    print("done");
}

async func skipAwait() {
    if (false) {
        await new PromiseSource<i32>().promise;
    }
    print("skipped");
}

async func multipleAwaits() {
    const sum = await Promise.resolve(1) + await Promise.resolve(2);
    print(sum);
}

async func loop() {
    var index = 0;
    while (index < 2) {
        index = await Promise.resolve(index + 1);
        print(index);
    }
}

ignore preserve(40);
ignore skipAwait();
ignore multipleAwaits();
ignore loop();
ignore new Runner().run();
print("outside");

first.resolve(2);
second.resolve(0);


