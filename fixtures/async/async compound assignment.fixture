var value = 1;
var values = [5];
var index = 0;

class Counter {
    public var number = 7;
}
var counter = new Counter();

func change() i32 {
    values[0] = 100;
    return 6;
}

async func run() {
    var local = 10;
    local += await Promise.resolve(2);
    value += await Promise.resolve(3);
    values[index++] += await Promise.resolve(4);
    counter.number += await Promise.resolve(5);
    values[await Promise.resolve(0)] += await Promise.resolve(change());
    values[await Promise.resolve(0)] += 2;
    print(local);
    print(value);
    print(values[0]);
    print(index);
    print(counter.number);
    print(values[0]);
}

ignore run();

