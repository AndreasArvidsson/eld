async func returnsThroughFinally() i32 {
    try {
        await Promise.resolve();
        return 42;
    } finally {
        print("return finally");
    }
}

async func throwsFromCatch() {
    try {
        await Promise.reject(new Exception("initial"));
    } catch (e: Exception) {
        print("catch");
        throw new Exception("from catch");
    } finally {
        print("throw finally");
    }
}

async func observe() {
    print(await returnsThroughFinally());
    try {
        await throwsFromCatch();
    } catch (e: Exception) {
        print(e.getMessage());
    }
}

ignore observe();

