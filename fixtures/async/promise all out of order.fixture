const first = new PromiseSource<i32>();
const second = new PromiseSource<i32>();

async func run() {
    const result = await Promise.all([
        first.promise,
        second.promise
    ]);

    print(result);
}

ignore run();

second.resolve(2);
print("second");

first.resolve(1);

