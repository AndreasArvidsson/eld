const foo = (1, true);
print(foo[0]);
print(foo[1]);
print(foo == foo);
print(foo == (1, true));
print(foo == (1, false));
const dynamicFoo: any = foo;
const dynamicEqual: any = (1, true);
print(dynamicFoo == dynamicEqual);

