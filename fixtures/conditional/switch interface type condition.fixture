interface Animal {}
interface Pet extends Animal {}
class Dog implements Pet {}
class Cat implements Animal {}
record Bird() implements Animal;

const selected: Type<Animal> = Dog;
switch (selected) {
    case Cat => print("cat")
    case Bird => print("bird")
    case Dog => print("dog")
    else => print("missing")
}

const contract: Type<Animal> = Pet;
switch (contract) {
    case Pet => print("pet")
    else => print("missing")
}

const javaType: Type<Collection<any>> = ArrayList;
switch (javaType) {
    case ArrayList => print("array list")
    else => print("missing")
}

