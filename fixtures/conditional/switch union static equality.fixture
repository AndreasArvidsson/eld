class Animal {
    public static const func equal(a: Animal, b: Animal) bool { return true; }
}
class Cat extends Animal {}
class Dog extends Animal {}

const subject: i32 | Animal = new Cat();
const match: Animal = new Dog();
switch (subject) {
    case match => print("found")
    else => print("missing")
}

