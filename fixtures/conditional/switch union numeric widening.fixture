const subject: i64 | string = 1;
switch (subject) {
    case 1 => print("one")
    else => print("missing")
}

const integer: i64 = 2;
switch (integer) {
    case 2 => print("two")
    else => print("missing")
}

const single: f32 = 1.5;
const floating: f64 | string = single;
switch (floating) {
    case single => print("float")
    else => print("missing")
}

const large: i64 = 100;
const mixed: i8 | i64 = large;
switch (mixed) {
    case 100 => print("wide member")
    else => print("missing")
}

const integerFirst: i64 | f64 = 1;
switch (integerFirst) {
    case 1 => print("integer first")
    else => print("missing")
}

const floatFirst: f64 | i64 = 1;
switch (floatFirst) {
    case 1 => print("float first")
    else => print("missing")
}

const literalUnion: i8 | i64 = 100;
switch (literalUnion) {
    case 100 => print("literal widened")
    else => print("missing")
}

const largerLiteralUnion: i8 | i64 = 1000;
switch (largerLiteralUnion) {
    case 1000 => print("larger literal widened")
    else => print("missing")
}

