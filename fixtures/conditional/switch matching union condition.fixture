const selected: string | null = "same";
const match: string | null = "same";

switch (selected) {
    case match => print("found")
    else => print("missing")
}

class Base {}
class Child extends Base {}
const child = new Child();
const broad: Base | null = child;
const narrow: Child | null = child;
switch (broad) {
    case narrow => print("derived")
    else => print("missing")
}

