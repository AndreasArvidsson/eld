try {
    throw new SQLException("database");
} catch (e: SQLException) {
    print(e.getMessage());
}

try {
    throw new SocketException("network");
} catch (e: SocketException) {
    print(e.getMessage());
}

try {
    throw new NoSuchElementException("collection");
} catch (e: NoSuchElementException) {
    print(e.getMessage());
}

