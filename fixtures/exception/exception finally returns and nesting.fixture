var value = 7;
func saved() i32 {
    try {
        return value;
    } finally {
        value = 9;
        print("saved cleanup");
    }
}
func nested() i64 {
    try {
        try {
            return 42;
        } finally {
            print("inner");
        }
    } finally {
        print("outer");
    }
}
func overridden() i32 {
    try {
        return 1;
    } finally {
        return 2;
    }
}
print(saved());
print(value);
print(nested());
print(overridden());

