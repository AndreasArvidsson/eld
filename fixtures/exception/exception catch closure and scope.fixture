var message: () => string | null = () => "initial";
try {
    throw new IOException("captured");
} catch (e: IOException) {
    message = () => e.getMessage();
}
print(message());
try {
    throw new IllegalArgumentException("second");
} catch (e: IllegalArgumentException) {
    print(e.getMessage());
}

