try {
    print("normal");
} finally {
    print("normal cleanup");
}
try {
    throw new IOException("caught");
} catch (e: IOException) {
    print(e.getMessage());
} finally {
    print("caught cleanup");
}
try {} catch (e: Exception) {
    print("wrong empty catch");
} finally {
    print("empty cleanup");
}

