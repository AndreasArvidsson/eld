func run() i32 {
    try {
        try {
            try {
                return 1;
            } finally {
                throw new IOException("cleanup");
            }
        } catch (e: IOException) {
            print(e.getMessage());
            return 2;
        } finally {
            print("middle");
        }
    } finally {
        print("outer");
    }
}
print(run());

