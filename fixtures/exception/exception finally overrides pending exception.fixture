func recovered() i32 {
    try {
        throw new IOException("discarded");
    } finally {
        return 3;
    }
}
print(recovered());
try {
    try {
        throw new IOException("old");
    } finally {
        throw new IllegalStateException("new");
    }
} catch (e: IllegalStateException) {
    print(e.getMessage());
}

