func run() i32 {
    try {
        return 1;
    } catch (e: IOException) {
        print("wrong catch");
        return 2;
    } finally {
        throw new IOException("cleanup");
    }
}
try {
    run();
} catch (e: IOException) {
    print(e.getMessage());
}

