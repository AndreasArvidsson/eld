try {
    throw new IllegalArgumentException("argument");
} catch (e: IOException) {
    print("wrong catch");
} catch (e: RuntimeException) {
    print(e.getMessage());
} catch (e: Exception) {
    print("wrong broad catch");
}
try {
    throw new Error("error");
} catch (e: Throwable) {
    print(e.getMessage());
}
try {
    throw new Exception("exception");
} catch (e: Exception) {
    print(e.getMessage());
}

