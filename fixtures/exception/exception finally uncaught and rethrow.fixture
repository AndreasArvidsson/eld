const original = new IOException("original");
try {
    try {
        throw original;
    } finally {
        print("inner cleanup");
    }
} catch (e: IOException) {
    print(e == original);
    try {
        try {
            throw e;
        } catch (again: IOException) {
            throw again;
        } finally {
            print("rethrow cleanup");
        }
    } catch (outer: IOException) {
        print(outer == original);
    }
}

