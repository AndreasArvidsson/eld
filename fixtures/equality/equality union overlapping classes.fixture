class Animal {
    public static func equal(a: Animal, b: Animal) bool { return true; }
}
class Cat extends Animal {
    public static func equal(a: Cat, b: Cat) bool { return false; }
}

const cat = new Cat();
const animal: Animal = cat;
const catFirst: Cat | Animal = cat;
const animalFirst: Animal | Cat = cat;

print(cat == cat);
print(animal == animal);
print(catFirst == catFirst);
print(animalFirst == animalFirst);

