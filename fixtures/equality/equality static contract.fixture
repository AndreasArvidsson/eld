class Animal {
    public static const func equal(a: Animal, b: Animal) bool { return true; }
    public const override func hashCode() i32 { return 0; }
}
class Cat extends Animal {
    public static const func equal(a: Cat, b: Cat) bool { return false; }
}
class Dog extends Animal {}

const cat: Animal = new Cat();
const dog: Animal = new Dog();
const nullableCat: Animal | null = cat;
const nullableDog: Animal | null = dog;
const absent: Animal | null = null;
print(cat == dog);
print(dog == cat);
print(nullableCat == nullableDog);
print(nullableDog == nullableCat);
print(cat == nullableDog);
print(nullableDog == cat);
print(nullableCat == absent);
print(absent == nullableDog);
print(absent == absent);
print(new Cat() == new Cat());
print(new Dog() == new Dog());
print(cat == cat);
const directCat = new Cat();
const nullableDirectCat: Cat | null = directCat;
print(directCat == cat);
print(cat == directCat);
print(nullableDirectCat == directCat);
print(directCat == nullableDirectCat);
const keys = {new Dog(): "found"};
print(keys.get(new Dog()));

