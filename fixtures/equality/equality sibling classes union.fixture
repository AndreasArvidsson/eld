class Animal {
    public static func equal(a: Animal, b: Animal) bool {
        return true;
    }
}
class Cat extends Animal {}
class Dog extends Animal {}

const cat: Animal = new Cat();
const dog: Animal = new Dog();
const unionCat: i32 | Animal = new Cat();
const unionDog: i32 | Animal = new Dog();

print(cat == dog);
print(dog == cat);
print(unionCat == dog);
print(dog == unionCat);
print(unionCat == unionDog);
print(unionDog == unionCat);

