const integer = 5;
print(5 == integer);
print(1 != integer);

const floatNumber = 5.5;
const floatZero = 0.0;
print(5.5 == floatNumber);
print(1.0 != floatNumber);
print(floatZero == 0);
print(floatZero == 0.0);

const boolean = true;
print(true == boolean);
print(false != boolean);

const character = 'A';
print('A' == character);
print('a' != character);

const str = "hello";
print("hello" == str);
print("Hello" != str);
print("""
hello
""" == str);

class Base {}
class Derived extends Base {}
const base = new Base();
const derived = new Derived();
const renamed: Base = derived;
print(derived == renamed);
print(base != derived);
print(base != new Base());

class Compare {
    public static func equal(a: Compare, b: Compare) bool {
        return true;
    }
}
const compare = new Compare();
const compareNullable: Compare | null = new Compare();
print(compare == new Compare());
print(compare == compareNullable);
print(compareNullable == compare);
print(compareNullable != null);

const unionPrimitive: i32 | bool = 5;
const unionComplex: i32 | Compare = 2;
const unionComplex2: i32 | Compare = new Compare();
print(unionPrimitive == 5);
print(unionPrimitive != true);
print(true != unionPrimitive);
if (true != unionPrimitive) { print("bool reverse"); }
print(unionComplex == 2);
print(unionComplex != new Compare());
print(unionComplex2 == new Compare());

