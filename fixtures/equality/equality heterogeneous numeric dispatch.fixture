const small: i8 = 100;
const smallUnion: i8 | i64 = small;
const large: i64 = 100;
const largeUnion: i8 | i64 = large;
print(smallUnion == 100);
print(largeUnion == 100);
print(100 == smallUnion);
print(100 == largeUnion);

const integerFirst: i64 | f64 = 1;
const floatFirst: f64 | i64 = 1;
print(integerFirst == 1);
print(floatFirst == 1);
const floatingValue: f64 = 1.0;
const floatingUnion: i64 | f64 = floatingValue;
print(floatingUnion == 1);

const textNumber: i64 | string = 1;
print(textNumber == 1);
const single: f32 = 1.5;
const floatingText: f64 | string = single;
print(floatingText == single);

var leftCalls = 0;
var rightCalls = 0;
func left() i8 | i64 { leftCalls++; return smallUnion; }
func right() i32 { rightCalls++; return 100; }
print(left() == right());
print(leftCalls);
print(rightCalls);
print(right() == left());
print(leftCalls);
print(rightCalls);
if (right() == left()) { print("reverse match"); }

