interface Marker {}
class Box implements Marker {
    public static func equal(a: Box, b: Box) bool { return true; }
}
class Child extends Box {
    public static func equal(a: Child, b: Child) bool { return false; }
}

const first: Box = new Child();
const second: Box = new Child();
const markerFirstA: Marker | Box = first;
const markerFirstB: Marker | Box = second;
const boxFirstA: Box | Marker = first;
const boxFirstB: Box | Marker = second;
const same: Marker | Box = first;

print(first == second);
print(markerFirstA == markerFirstB);
print(boxFirstA == boxFirstB);
print(markerFirstA == same);
const dynamicFirst: any = first;
const dynamicSecond: any = second;
print(dynamicFirst == dynamicSecond);
print(dynamicFirst == dynamicFirst);
const dynamicBaseA: any = new Box();
const dynamicBaseB: any = new Box();
print(dynamicBaseA == dynamicBaseB);
print(dynamicFirst == dynamicBaseA);
print(dynamicBaseA == dynamicFirst);

