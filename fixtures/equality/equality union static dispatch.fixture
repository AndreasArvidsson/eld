class Animal {
    public static func equal(a: Animal, b: Animal) bool { return true; }
}
class Cat extends Animal {}
class Dog extends Animal {}

const cat: Animal = new Cat();
const dog: Animal = new Dog();
const unionCat: i32 | Animal = new Cat();
const unionDog: i32 | Animal = new Dog();
const nullableCat: i32 | Animal | null = new Cat();
const nullableDog: i32 | Animal | null = new Dog();
const missing: i32 | Animal | null = null;
print(cat == dog);
print(unionCat == dog);
print(dog == unionCat);
print(unionCat == unionDog);
print(nullableCat == dog);
print(dog == nullableCat);
print(nullableCat == nullableDog);
print(missing == missing);
print(missing == dog);
print(dog == missing);

const number32: i32 | Animal = 5;
const number64: i64 | Animal = 5;
print(number32 == number64);
print(number64 == number32);
print(number32 == unionCat);

var calls = 0;
func nextNumber() i32 | Animal {
    calls++;
    return number32;
}
print(nextNumber() == number64);
print(number64 == nextNumber());
print(calls);
func nextAnimal() i32 | Animal {
    calls++;
    return new Cat();
}
print(nextAnimal() == dog);
print(dog == nextAnimal());
print(calls);

