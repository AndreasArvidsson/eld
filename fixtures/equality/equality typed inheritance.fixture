class Animal {
    public static func equal(a: Animal, b: Animal) bool { return true; }
    public func through(other: Animal) bool { return Animal.equal(this, other); }
}
class Cat extends Animal {
    public static func equal(a: Cat, b: Cat) bool { return false; }
}
class Dog extends Animal {}

const animal: Animal = new Cat();
const cat = new Cat();
const anotherCat = new Cat();
const dog = new Dog();
const otherDog = new Dog();
print(animal == cat);
print(cat == animal);
print(animal == dog);
print(dog == animal);
print(Animal.equal(animal, cat));
print(Animal.equal(animal, dog));
print(cat.through(dog));
print(dog == otherDog);
print(cat == anotherCat);

