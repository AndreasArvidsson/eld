const left: List<i32> = new ArrayList<i32>();
const right: List<i32> = new LinkedList<i32>();
const same: List<i32> = new ArrayList<i32>();
const different: List<i32> = new ArrayList<i32>();
left.add(1);
right.add(1);
same.add(1);
different.add(2);
print(left == right);
print(left == same);
print(left == different);
const dynamicLeft: any = left;
const dynamicSame: any = same;
print(dynamicLeft == dynamicSame);
print(dynamicLeft == dynamicLeft);
const nullableLeft: List<i32> | null = left;
const nullableSame: List<i32> | null = same;
print(nullableLeft == nullableSame);
const nullableEmpty: List<i32> | null = null;
print(nullableEmpty == nullableEmpty);
print(nullableLeft == nullableEmpty);
print(nullableEmpty == nullableLeft);

