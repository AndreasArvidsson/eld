class Value {
    public func hashCode(value: i32) i32 { return value; }
    public const override func hashCode() i32 { return 0; }
}
const func addValue() i32 {
    var values = new HashSet<Value>();
    values.add(new Value());
    return values.size();
}
print(addValue());

