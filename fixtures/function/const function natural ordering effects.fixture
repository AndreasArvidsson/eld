var comparisons = 0;

class Value implements Comparable<Value> {
    public func compareTo(other: Value) i32 {
        comparisons++;
        return 0;
    }
}

const func sorted() {
    var values: List<Value> = [new Value(), new Value()];
    values.sort();
}

