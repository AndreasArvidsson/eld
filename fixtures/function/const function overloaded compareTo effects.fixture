class Value implements Comparable<Value> {
    public const func compareTo(other: i32) i32 { return 0; }
    public func compareTo(other: Value) i32 { print("effect"); return 0; }
}
const func sorted() {
    var values: List<Value> = [new Value(), new Value()];
    values.sort();
}
sorted();

