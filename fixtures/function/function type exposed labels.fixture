func sum(a: i32, b: i32) i32 {
    return a + b;
}

func named(a: i32, *, b: i32) i32 {
    return a + b;
}

const plain: (i32, i32) => i32 = sum;
const labeled: (a: i32, b: i32) => i32 = sum;
const renamed: (x: i32, y: i32) => i32 = sum;
const partial: (i32, *, b: i32) => i32 = named;
const full: (a: i32, *, b: i32) => i32 = named;
const renamedNamed: (i32, *, z: i32) => i32 = named;

print(plain(1, 2));
print(labeled(1, 2));
print(labeled(a: 1, b: 2));
print(labeled(1, b: 2));
print(renamed(x: 1, y: 2));
print(partial(1, b: 2));
print(full(a: 1, b: 2));
print(renamedNamed(1, z: 2));

