func describe(value: i32) string { return "integer"; }
func describe(value: string) string { return "string"; }

const integerFunction: (i32) => string = describe;
const stringFunction: (string) => string = describe;
print(integerFunction(2));
print(stringFunction("hello"));

class Describer {
    public func describe(value: i32) string { return "integer method"; }
    public func describe(value: string) string { return "string method"; }
}

const describer = new Describer();
const integerMethod: (i32) => string = describer.describe;
const stringMethod: (string) => string = describer.describe;
print(integerMethod(2));
print(stringMethod("hello"));

