interface I {
    func f(value: i32) i32;
    func f(value: string) i32;
}
class C implements I {
    public func f(value: string) i32 { return 2; }
    public const func f(value: i32) i32 { return 1; }
}
const func test(value: I) i32 { return value.f(1); }
print(test(new C()));

