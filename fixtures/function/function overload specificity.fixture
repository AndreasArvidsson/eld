class Animal {}
class Dog extends Animal {}

func describe(value: Animal) string { return "animal"; }
func describe(value: Dog) string { return "dog"; }

const dog: Dog = new Dog();
const animal: Animal = dog;
print(describe(dog));
print(describe(animal));

