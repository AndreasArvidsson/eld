func apply(value: i32, mapper: (i32) => i32) i32 {
    return mapper(value);
}
func apply(value: string, mapper: (string) => string) string {
    return mapper(value);
}

print(apply(2, (value) => value + 1));

func produce(value: i32, factory: () => i32) i32 { return value + factory(); }
func produce(value: string, factory: () => string) string { return value + factory(); }
print(produce(2, () => 3));

