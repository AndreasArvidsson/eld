func describe(factory: () => i32) string { return "integer"; }
func describe(factory: () => string) string { return "string"; }

print(describe(() => 1));
print(describe(() => "hello"));
print(describe(() => { return 2; }));

func transform(mapper: (i32) => i32) string { return "integer mapper"; }
func transform(mapper: (string) => string) string { return "string mapper"; }
print(transform((value) => value * 2));

