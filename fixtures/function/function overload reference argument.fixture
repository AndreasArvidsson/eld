func describe(value: i32) string { return "integer"; }
func describe(value: string) string { return "string"; }
func apply(value: i32, mapper: (i32) => string) string { return mapper(value); }
func apply(value: string, mapper: (string) => string) string { return mapper(value); }

print(apply(2, describe));
print(apply("x", describe));

class Describer {
    public func describe(value: i32) string { return "integer method"; }
    public func describe(value: string) string { return "string method"; }
}
const describer = new Describer();
print(apply(2, describer.describe));
print(apply("x", describer.describe));

