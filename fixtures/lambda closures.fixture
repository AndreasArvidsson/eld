var count = 0;
const expression = () => 42;
const action = () => { count++; };
func run() {
    var value = 1;
    const next = () => { value++; return value; };
    const read = () => value;
    value = 4;
    print(next());
    print(read());
}
action();
print(count);
print(expression());
run();

