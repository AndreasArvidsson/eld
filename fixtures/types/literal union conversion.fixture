func check(source: 0 | 1 | 2) {
    const target: 0 | 1 | i64 = source;
    print(target == 0);
    print(target == 1);
    switch (target) {
        case 0 { print("zero"); }
        case 1 { print("one"); }
        else { print("wide"); }
    }
}
check(0);
check(1);
check(2);
const ordinaryZero: i32 = 0;
const ordinarySource: i32 | string = ordinaryZero;
const ordinaryTarget: i64 | 0 | string = ordinarySource;
print(ordinaryTarget == 0);
const ordinaryOne: i32 = 1;
const otherSource: i32 | string = ordinaryOne;
const otherTarget: i64 | 0 | string = otherSource;
print(otherTarget == 0);
const wideZero: i64 = 0;
const wideTarget: 0 | i64 = wideZero;
print(wideTarget.getClass());
print(wideTarget == 0);
switch (wideTarget) {
    case 0 { print("wide zero"); }
    else { print("missing"); }
}
const wideSource: i64 | string = wideZero;
const wideUnionTarget: 0 | i64 | string = wideSource;
print(wideUnionTarget == 0);
const values: [0 | i64] = [wideZero];
print(values[0] == 0);
const pair: (0 | i64, string) = (wideZero, "ok");
print(pair[0] == 0);
const smallZero: i8 = 0;
const smallTarget: 0 | i8 = smallZero;
print(smallTarget == 0);
const none: 0 | null = null;
print(none);
const some: 0 | null = 0;
print(some == 0);
const floatingZero: f64 = 0.0;
const floatingTarget: 0 | f64 = floatingZero;
print(floatingTarget);
print(floatingTarget == 0);
const restoredFloating: f64 = floatingTarget;
print(restoredFloating == 0.0);
switch (floatingTarget) {
    case 0 { print("floating zero"); }
    else { print("missing floating zero"); }
}
const smallFloatingZero: f32 = 0.0;
const smallFloatingTarget: 0 | f32 = smallFloatingZero;
print(smallFloatingTarget == 0);
const floatingOne: f64 = 1.0;
const oneTarget: 1 | f64 = floatingOne;
print(oneTarget);
print(oneTarget == 1);
const negativeZero: f64 = -0.0;
const negativeTarget: 0 | f64 = negativeZero;
print(negativeTarget);
print(negativeTarget == 0);
switch (negativeTarget) {
    case 0 {
        const matched: f64 = negativeTarget;
        print(1.0 / matched);
    }
    else { print("missing negative zero"); }
}
const restoredNegative: f64 = negativeTarget;
print(1.0 / restoredNegative);
const smallNegativeZero: f32 = -0.0;
const smallNegativeTarget: 0 | f32 = smallNegativeZero;
const restoredSmallNegative: f32 = smallNegativeTarget;
print(1.0 / restoredSmallNegative);

