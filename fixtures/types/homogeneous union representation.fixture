func identity(value: 0 | 1) 0 | 1 {
    return value;
}

const value: 0 | 1 = identity(1);
print(value);
const values: [0 | 1] = [0, 1];
print(values[1] == 1);
const pair: (0 | 1, string) = (1, "ok");
print(pair[0] == 1);
const mixed: i32 | string = value;
print(mixed == 1);
const unknown: any = value;
print(unknown == 1);
const words: "yes" | "no" = "yes";
print(words == "yes");

