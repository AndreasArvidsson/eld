const choice: 0 | 1 = 1;
switch (choice) {
    case 0 { print("zero"); }
    case 1 { print("one"); }
}
const only: 0 = 0;
switch (only) {
    case 0 { print("only zero"); }
}
const status: "success" | "error" = "error";
switch (status) {
    case "success" { print("ok"); }
    case "error" { print("failed"); }
}
const flag: true = true;
switch (flag) {
    case true { print("true"); }
}
const either: true | false = false;
switch (either) {
    case false { print("false"); }
}

