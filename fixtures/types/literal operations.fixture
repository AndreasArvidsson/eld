func sideEffect() bool {
    print("evaluated");
    return true;
}

const word: "foo" = "foo";
const number: 1 = 1;
const flag: true = true;
if (flag) {
    print(word.toString());
}
print(word + "bar");
print(word == "foo");
print(number + 2);
print(number == 1);
print(!flag);
print(flag && false);
print(sideEffect() && false);

