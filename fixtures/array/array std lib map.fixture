const objects: [any] = [1, "a", true, "a"];
print(objects.map((value, index) => index));
const bytes: [i8] = [1, 2, 3, 2];
print(bytes.map((value, index) => 2 * value));
const shorts: [i16] = [1, 2, 3, 2];
print(shorts.map((value, index) => 2 * value));
const ints: [i32] = [1, 2, 3, 2];
print(ints.map((value, index) => 2 * value));
const intStrings = ints.map((value, index) => value.toString());
print(intStrings);
const longs: [i64] = [1, 2, 3, 2];
print(longs.map((value, index) => 2 * value));
const floats: [f32] = [1.0, 2.0, 3.0, 2.0];
print(floats.map((value, index) => 2.0 * value));
const doubles: [f64] = [1.0, 2.0, 3.0, 2.0];
print(doubles.map((value, index) => 2.0 * value));
const bools: [bool] = [false, true, false, true];
print(bools.map((value, index) => !value));
const chars: [char] = ['a', 'b', 'c', 'b'];
print(chars.map((value, index) => value));
const strings: [string] = ["a", "b", "c", "b"];
print(strings.map((value, index) => value + value));

