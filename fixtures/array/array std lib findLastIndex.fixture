const objects: [any] = [1, "a", true, "a"];
print(objects.findLastIndex((value, index) => value == "a"));
const bytes: [i8] = [1, 2, 3, 2];
print(bytes.findLastIndex((value, index) => value > 1));
const shorts: [i16] = [1, 2, 3, 2];
print(shorts.findLastIndex((value, index) => value > 1));
const ints: [i32] = [1, 2, 3, 2];
print(ints.findLastIndex((value, index) => value > 1));
const longs: [i64] = [1, 2, 3, 2];
print(longs.findLastIndex((value, index) => value > 1));
const floats: [f32] = [1.0, 2.0, 3.0, 2.0];
print(floats.findLastIndex((value, index) => value > 1));
const doubles: [f64] = [1.0, 2.0, 3.0, 2.0];
print(doubles.findLastIndex((value, index) => value > 1));
const bools: [bool] = [false, true, false, true];
print(bools.findLastIndex((value, index) => value));
const chars: [char] = ['a', 'b', 'c', 'b'];
print(chars.findLastIndex((value, index) => value == 'b'));
const strings: [string] = ["a", "b", "c", "b"];
print(strings.findLastIndex((value, index) => value == "b"));
print(strings.findLastIndex((value, index) => false));

