const left = [1, 2, 3];
const right = [1, 2, 3];
print(left == right);
print(left.hashCode() == right.hashCode());
print(left.toString() == right.toString());

const bytesA: [i8] = [1];
const bytesB: [i8] = [1];
print(bytesA == bytesB);

const shortsA: [i16] = [1];
const shortsB: [i16] = [1];
print(shortsA == shortsB);

const longsA: [i64] = [1];
const longsB: [i64] = [1];
print(longsA == longsB);

const floatsA: [f32] = [1.5];
const floatsB: [f32] = [1.5];
print(floatsA == floatsB);

const doublesA: [f64] = [1.5];
const doublesB: [f64] = [1.5];
print(doublesA == doublesB);

const booleansA: [bool] = [true];
const booleansB: [bool] = [true];
print(booleansA == booleansB);

const charsA: [char] = ['a'];
const charsB: [char] = ['a'];
print(charsA == charsB);

const stringsA: [string] = ["same"];
const stringsB: [string] = ["same"];
print(stringsA == stringsB);

const nestedA = [[1, 2]];
const nestedB = [[1, 2]];
print(nestedA == nestedB);

