const objects: [any] = [1, "a", true, "a"];
print(objects.findIndex((value, index) => value == "a"));
const bytes: [i8] = [1, 2, 3, 2];
print(bytes.findIndex((value, index) => value == 2));
const shorts: [i16] = [1, 2, 3, 2];
print(shorts.findIndex((value, index) => value == 2));
const ints: [i32] = [1, 2, 3, 2];
print(ints.findIndex((value, index) => value == 2));
const longs: [i64] = [1, 2, 3, 2];
print(longs.findIndex((value, index) => value == 2));
const floats: [f32] = [1.0, 2.0, 3.0, 2.0];
print(floats.findIndex((value, index) => value == 2.0));
const doubles: [f64] = [1.0, 2.0, 3.0, 2.0];
print(doubles.findIndex((value, index) => value == 2.0));
const bools: [bool] = [false, true, false, true];
print(bools.findIndex((value, index) => value == true));
const chars: [char] = ['a', 'b', 'c', 'b'];
print(chars.findIndex((value, index) => value == 'b'));
const strings: [string] = ["a", "b", "c", "b"];
print(strings.findIndex((value, index) => value == "b"));
print(strings.findIndex((value, index) => false));

