const objects: [any] = [1, "a", true, "a"];
print(objects.none((value, index) => index == 1));
const bytes: [i8] = [1, 2, 3, 2];
print(bytes.none((value, index) => value == 4));
const shorts: [i16] = [1, 2, 3, 2];
print(shorts.none((value, index) => value == 2));
const ints: [i32] = [1, 2, 3, 2];
print(ints.none((value, index) => value == 2));
const longs: [i64] = [1, 2, 3, 2];
print(longs.none((value, index) => value == 2));
const floats: [f32] = [1.0, 2.0, 3.0, 2.0];
print(floats.none((value, index) => value == 2.0));
const doubles: [f64] = [1.0, 2.0, 3.0, 2.0];
print(doubles.none((value, index) => value == 2.0));
const bools: [bool] = [false, true, false, true];
print(bools.none((value, index) => value == true));
const chars: [char] = ['a', 'b', 'c', 'b'];
print(chars.none((value, index) => value == 'b'));
const strings: [string] = ["a", "b", "c", "b"];
print(strings.none((value, index) => value == "b"));
print([].none((value, index) => true));

