const objects: [any] = [1, "a", true, "a"];
print(objects.findLast((value, index) => index > 1));
const bytes: [i8] = [1, 2, 3, 2];
print(bytes.findLast((value, index) => value > 1));
const shorts: [i16] = [1, 2, 3, 2];
print(shorts.findLast((value, index) => value > 1));
const ints: [i32] = [1, 2, 3, 2];
print(ints.findLast((value, index) => value > 1));
const longs: [i64] = [1, 2, 3, 2];
print(longs.findLast((value, index) => value > 1));
const floats: [f32] = [1.0, 2.0, 3.0, 2.0];
print(floats.findLast((value, index) => value > 1));
const doubles: [f64] = [1.0, 2.0, 3.0, 2.0];
print(doubles.findLast((value, index) => value > 1));
const bools: [bool] = [false, true, false, true];
print(bools.findLast((value, index) => index > 1));
const chars: [char] = ['a', 'b', 'c', 'b'];
print(chars.findLast((value, index) => index > 1));
const strings: [string] = ["a", "b", "c", "b"];
print(strings.findLast((value, index) => index > 1));
print(strings.findLast((value, index) => false));
print([].any((value, index) => true));

