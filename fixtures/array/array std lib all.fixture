const objects: [any] = [1, "a", true, "a"];
print(objects.all((value, index) => index >= 0));
const bytes: [i8] = [1, 2, 3, 2];
print(bytes.all((value, index) => value > 0));
const shorts: [i16] = [1, 2, 3, 2];
print(shorts.all((value, index) => value > 0));
const ints: [i32] = [1, 2, 3, 2];
print(ints.all((value, index) => value > 0));
const longs: [i64] = [1, 2, 3, 2];
print(longs.all((value, index) => value > 0));
const floats: [f32] = [1.0, 2.0, 3.0, 2.0];
print(floats.all((value, index) => value > 0.0));
const doubles: [f64] = [1.0, 2.0, 3.0, 2.0];
print(doubles.all((value, index) => value > 0.0));
const bools: [bool] = [false, true, false, true];
print(bools.all((value, index) => value));
const chars: [char] = ['a', 'b', 'c', 'b'];
print(chars.all((value, index) => value >= 'a'));
const strings: [string] = ["a", "b", "c", "b"];
print(strings.all((value, index) => index >= 0));
print([].all((value, index) => index >= 0));

