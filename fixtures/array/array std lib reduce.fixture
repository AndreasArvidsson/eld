const objects: [any] = [1, "a", true, "a"];
print(objects.reduce((acc, value, index) => acc + index, 0));
const bytes: [i8] = [1, 2, 3, 2];
print(bytes.reduce((acc, value, index) => acc + value, 0));
const shorts: [i16] = [1, 2, 3, 2];
print(shorts.reduce((acc, value, index) => acc + value, 0));
const ints: [i32] = [1, 2, 3, 2];
print(ints.reduce((acc, value, index) => acc + value, 0));
const longs: [i64] = [1, 2, 3, 2];
const longStart: i64 = 0;
print(longs.reduce((acc, value, index) => acc + value, longStart));
const floats: [f32] = [1.0, 2.0, 3.0, 2.0];
print(floats.reduce((acc, value, index) => acc + value, 0.0));
const doubles: [f64] = [1.0, 2.0, 3.0, 2.0];
print(doubles.reduce((acc, value, index) => acc + value, 0.0));
const bools: [bool] = [false, true, false, true];
print(bools.reduce((acc, value, index) => acc || value, false));
const chars: [char] = ['a', 'b', 'c', 'b'];
print(chars.reduce((acc, value, index) => acc + index, 0));
const strings: [string] = ["a", "b", "c", "b"];
print(strings.reduce((acc, value, index) => acc + value, ""));

