const bytes: [i8] = [1, 2, 3, 2];
bytes.sortInPlace((a, b) => b.compareTo(a));
print(bytes);
const shorts: [i16] = [1, 2, 3, 2];
shorts.sortInPlace((a, b) => b.compareTo(a));
print(shorts);
