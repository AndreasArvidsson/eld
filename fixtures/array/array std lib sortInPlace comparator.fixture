ints.sortInPlace((a, b) => b.compareTo(a));
print(ints);
const longs: [i64] = [1, 2, 3, 2];
longs.sortInPlace((a, b) => b.compareTo(a));
print(longs);
const floats: [f32] = [1.0, 2.0, 3.0, 2.0];
floats.sortInPlace((a, b) => b.compareTo(a));
print(floats);
const doubles: [f64] = [1.0, 2.0, 3.0, 2.0];
doubles.sortInPlace((a, b) => b.compareTo(a));
print(doubles);
const bools: [bool] = [false, true, false, true];
bools.sortInPlace((a, b) => b.compareTo(a));
print(bools);
const chars: [char] = ['a', 'b', 'c', 'b'];
chars.sortInPlace((a, b) => b.compareTo(a));
print(chars);
const strings: [string] = ["a", "b", "c", "b"];
strings.sortInPlace((a, b) => b.compare(a));
print(strings);

