enum Direction {
    NORTH,
    SOUTH
}

print(Direction.NORTH);
print(Direction.NORTH.name());
print(Direction.SOUTH.ordinal());
print(Direction.valueOf("SOUTH") == Direction.SOUTH);
print(Direction.values()[0] == Direction.NORTH);

