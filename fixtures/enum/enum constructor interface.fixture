interface Complete {
    func isComplete() bool;
}

enum Status implements Complete {
    PENDING("Pending"),
    SUCCESS("Success"),
    ERROR("Error");

    public const label: string;

    Status(label: string) {
        this.label = label;
    }

    public func isComplete() bool {
        return this == SUCCESS || this == ERROR;
    }
}

print(Status.PENDING.label);
print(Status.SUCCESS.isComplete());
print(Status.PENDING.isComplete());

