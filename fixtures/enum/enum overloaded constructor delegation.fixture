enum Status {
    EMPTY(),
    TEXT("text"),
    NUMBER(7);

    public const label: string;
    Status() { this("default"); }
    Status(label: string) { this.label = label; }
    Status(value: i32) { this(f"number: {value}"); }
}
print(Status.EMPTY.label);
print(Status.TEXT.label);
print(Status.NUMBER.label);

