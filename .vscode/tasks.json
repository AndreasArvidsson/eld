{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: Run tests",
      "type": "shell",
      "command": "mvn",
      "args": [
        {
          "quoting": "strong",
          "value": "--batch-mode"
        },
        {
          "quoting": "strong",
          "value": "-Dstyle.color=never"
        },
        {
          "quoting": "strong",
          "value": "test"
        },
        {
          "quoting": "strong",
          "value": "-Dmaven.surefire.debug"
        }
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "maven",
        "pattern": {
          "regexp": "^\\[ERROR\\] (.+):\\[(\\d+),(\\d+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[INFO\\] Scanning for projects",
          "endsPattern": "Listening for transport dt_socket at address: 5005"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
