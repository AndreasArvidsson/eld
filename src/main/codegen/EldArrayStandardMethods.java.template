    public ${SELF} filter(final MethodHandle predicate) throws Throwable {
        final ${SELF} result = copy();
        int count = 0;
        for (int index = 0; index < length; index++) {
            final ${ELEMENT_TYPE} value = elements[index];
            if (test(predicate, value, index)) {
                result.elements[count++] = value;
            }
        }
${FILTER_CLEANUP}
        result.length = count;
        return result;
    }

