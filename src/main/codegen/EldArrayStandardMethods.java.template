${COMPARATOR_SORT_HELPER}

    private static boolean test(final MethodHandle callback, final ${ELEMENT_TYPE} value, final int index) throws Throwable {
        return callback.type().parameterCount() == 2
            ? (boolean) callback.invoke(value, index)
            : (boolean) callback.invoke(value);
    }
