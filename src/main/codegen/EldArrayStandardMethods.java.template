    @EldApi
    public ${SELF} intersect(final ${SELF} additional) {
        final ${SELF} result = new ${SELF}();
        for (int index = 0; index < length; index++) {
            final ${VALUE_TYPE} value = get(index);
            if (additional.contains(value) && !result.contains(value)) {
