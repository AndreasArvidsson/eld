    @EldApi
    public ${SELF} filter(final MethodHandle predicate) throws Throwable {
        final ${SELF} result = copy();
        int count = 0;
        for (int index = 0; index < length; index++) {
            final ${ELEMENT_TYPE} value = elements[index];
            if (test(predicate, value, index)) {
                result.elements[count++] = value;
            }
        }
${FILTER_CLEANUP}
        result.length = count;
        return result;
    }

    @EldApi
    public EldTuple partition(final MethodHandle predicate) throws Throwable {
        final ${SELF} matching = new ${SELF}();
        final ${SELF} remaining = new ${SELF}();
        for (int index = 0; index < length; index++) {
            final ${VALUE_TYPE} value = get(index);
            if (test(predicate, value, index)) {
                matching.add(value);
            }
            else {
                remaining.add(value);
            }
        }
        return new EldTuple(new Object[] {matching, remaining});
    }

